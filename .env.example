# Copilote IA (facultatif). Sans clé, le portail fonctionne et le copilote passe en mode hors ligne.
ANTHROPIC_API_KEY=

# Modèle utilisé par le copilote (défaut : claude-opus-5-5).
# COPILOTE_MODELE=claude-opus-5-5

# Protection d'accès (facultatif). Si défini, tout le portail exige ce mot de passe (authentification HTTP Basic).
# PORTAIL_MOT_DE_PASSE=
